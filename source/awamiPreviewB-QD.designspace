                <dimension name="custom" xvalue="0.000000" />
            </location>
            <info />
            <kerning />
        </instance>
-->

        <!-- Bold -->
        <instance      familyname="Awami Preview B QD"
                         filename="instances/AwamiPreviewB-QD-Bold.ufo"
                             name="Awami Preview B QD Bold"
               stylemapfamilyname="Awami Preview B QD"
                        stylename="Bold"
                stylemapstylename="bold"
               postscriptfontname="AwamiPreviewB-QD-Bold">
            <location>
                <dimension name="weight" xvalue="700.000000" />    <!-- design weight -->
                <dimension name="width"  xvalue="100.000000" />
                <dimension name="custom" xvalue="0.000000" />
            </location>
            <info />
            <kerning />
        </instance>

        <!-- Extra-Bold-->
<!--
        <instance      familyname="Awami Preview B QD"
