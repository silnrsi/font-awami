languagesystem latn dflt ;
languagesystem arab dflt;


def SliceWidth() {
	return 200			# 100 for best rendering, 200 for optimized performance
} SliceWidth;

#======================  CLASSES  ======================

# Currently most classes are defined in classes.xml.

include(../../source/opentype/bariyehKernClasses.feax);


#=================  AUXILIARY LOOKUPS  =================

include(../../source/opentype/arithClasses.feax);
include(../../source/opentype/arithmetic.feax);
include(../../source/opentype/kerncalc.feax);

include(../../source/opentype/aux_inc.feax);


#===================  GSUB features  ===================

include(../../source/opentype/gsub.feax);


# --- Auto-kerning ---

# We keep this in the main.feax file because lines below are modified by the wscript.

include(../../source/opentype/autokern_inc.feax);

feature rclt {	# eventually change this to a Stylistic Set?
script arab;

# -------
# WARNING! The following lines are modified by the wscript. 
# Do not change them without adjusting the wscript to match!

def AutoKern() {
	return 1    # toggle to switch between auto- and hand-kerning; -1 for no kerning at all
} AutoKern;     # \/  \/  \/		NOTE: this is modified by the wscript!!
#               # \/  \/  \/
# Can't use the AutoKern() conditional for this file; TOGGLE BY HAND.	
include(../../source/opentype/autokern.feax);

# -------

# We need some hand-kerning even when doing auto-kerning.
include(../../source/opentype/handkern.feax);

do	if AutoKern() == 0; {
	# And we need even more hand-kerning when auto-kerning is turned off.
	include(../../source/opentype/handkernextra.feax);
}

} rclt;


#===================  GPOS features  ===================

include(../../source/opentype/gpos.feax);
