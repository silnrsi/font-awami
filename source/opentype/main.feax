feature rlig {

lookup SignWithDigits {
	lookupflag IgnoreMarks;

	# Uniscribe or HarfBuzz 'latn'
    sub [ absNumberSign absYearSign absSamvat absPageSign ]' lookup _SignWith_4digits
        @DigitsAny' lookup _SignDigits_ToSmall
        @DigitsAny' lookup _SignDigits_ToSmall
        @DigitsAny' lookup _SignDigits_ToSmall
        @DigitsAny' lookup _SignDigits_ToSmall ;	
    sub [ absNumberSign absYearSign absSamvat absPageSign ]' lookup _SignWith_3digits
        @DigitsAny' lookup _SignDigits_ToSmall
        @DigitsAny' lookup _SignDigits_ToSmall
        @DigitsAny' lookup _SignDigits_ToSmall ;
    sub [ absEndOfAyah ]' lookup _SignWith_3digits
        @DigitsAny' lookup _SignDigits_ToSmaller
        @DigitsAny' lookup _SignDigits_ToSmaller
        @DigitsAny' lookup _SignDigits_ToSmaller ;
    sub [ absNumberSign absYearSign absSamvat absFootnoteSign absPageSign  ]' lookup _SignWith_2digits
        @DigitsAny' lookup _SignDigits_ToSmall
        @DigitsAny' lookup _SignDigits_ToSmall ;
    sub [ absEndOfAyah ]' lookup _SignWith_2digits
        @DigitsAny' lookup _SignDigits_ToSmaller
        @DigitsAny' lookup _SignDigits_ToSmaller ;
    sub [ absNumberSign absYearSign absSamvat absFootnoteSign absPageSign ]'
        @DigitsAny' lookup _SignDigits_ToSmall ;
    sub [ absEndOfAyah ]'
        @DigitsAny' lookup _SignDigits_ToSmaller ;

# HarfBuzz 'arab'
    sub @DigitsAny' lookup _SignDigits_ToSmall
        @DigitsAny' lookup _SignDigits_ToSmall
        @DigitsAny' lookup _SignDigits_ToSmall
        @DigitsAny' lookup _SignDigits_ToSmall
        [ absNumberSign absYearSign absSamvat absPageSign ]' lookup _SignWith_4digits ;  # poundmarkabove, piastremarkabove
    sub @DigitsAny' lookup _SignDigits_ToSmall
        @DigitsAny' lookup _SignDigits_ToSmall
        @DigitsAny' lookup _SignDigits_ToSmall
        [ absNumberSign absYearSign absSamvat absPageSign ]' lookup _SignWith_3digits ;
    sub @DigitsAny' lookup _SignDigits_ToSmaller
        @DigitsAny' lookup _SignDigits_ToSmaller
        @DigitsAny' lookup _SignDigits_ToSmaller
        [ absEndOfAyah ]' lookup _SignWith_3digits ;
    sub @DigitsAny' lookup _SignDigits_ToSmall
        @DigitsAny' lookup _SignDigits_ToSmall
        [ absNumberSign absYearSign absSamvat absFootnoteSign absPageSign ]' lookup _SignWith_2digits ;
	sub @DigitsAny' lookup _SignDigits_ToSmaller
        @DigitsAny' lookup _SignDigits_ToSmaller
        [ absEndOfAyah ]'  lookup _SignWith_2digits;
    sub @DigitsAny' lookup _SignDigits_ToSmall
        [ absNumberSign absYearSign absSamvat absFootnoteSign absPageSign ]' ;
    sub @DigitsAny' lookup _SignDigits_ToSmaller
        [ absEndOfAyah ]' ;

} SignWithDigits;


} rlig;



#====================  GPOS features  ====================


# Putting the curs feature first seems to be better for MS Word, especially for getting kaf tops to work.
feature curs {
script arab;

lookup BasicConnections {
	lookupflag IgnoreMarks RightToLeft;
	pos cursive @entry @exit;
} BasicConnections;
	
} curs;			# end of feature


feature kern {
script arab;

#lookup TempTest {
#	lookupflag 0;
#	pos absRehFin._jkl'  <-650 0 -650 0>  absBehIni.sn _dot2u  absSeenFin;
#} TempTest;

lookup ShiftNuqtasNS {
	lookupflag UseMarkFilteringSet [@Shiftable @CfMarkerNS];
	pos @Shiftable' <0  100 0 0> cfN100;
	pos @Shiftable' <0  200 0 0> cfN200;
	pos @Shiftable' <0  300 0 0> cfN300;
	pos @Shiftable' <0  400 0 0> cfN400;
	pos @Shiftable' <0  500 0 0> cfN500;
	pos @Shiftable' <0  600 0 0> cfN600;
	pos @Shiftable' <0  700 0 0> cfN700;

	pos @Shiftable' <0 -100 0 0> cfS100;
	pos @Shiftable' <0 -200 0 0> cfS200;
	pos @Shiftable' <0 -300 0 0> cfS300;
	pos @Shiftable' <0 -400 0 0> cfS400;
	pos @Shiftable' <0 -500 0 0> cfS500;
	pos @Shiftable' <0 -600 0 0> cfS600;
	pos @Shiftable' <0 -700 0 0> cfS700;
} ShiftNuqtasNS;

lookup ShiftNuqtasEW {
	lookupflag UseMarkFilteringSet [@Shiftable @CfMarkerEW];
	pos @Shiftable' < 100 0 0 0> cfE100;
	pos @Shiftable' < 200 0 0 0> cfE200;
	pos @Shiftable' < 300 0 0 0> cfE300;
	pos @Shiftable' < 400 0 0 0> cfE400;
	pos @Shiftable' < 500 0 0 0> cfE500;

	pos @Shiftable' <-100 0 0 0> cfW100;
	pos @Shiftable' <-200 0 0 0> cfW200;
	pos @Shiftable' <-300 0 0 0> cfW300;
	pos @Shiftable' <-400 0 0 0> cfW400;
	pos @Shiftable' <-500 0 0 0> cfW500;
} ShiftNuqtasEW;

lookup DoKerning {
	lookupflag UseMarkFilteringSet @KwMarker;

do	if AutoKern() == 1; {
	# For auto-kerning, it helps to just loosen everything up a little.
	pos @GDEF_bases <2400 0 2400 0> kwN2400;
	pos @GDEF_bases <2300 0 2300 0> kwN2300;
	pos @GDEF_bases <2200 0 2200 0> kwN2200;
	pos @GDEF_bases <2100 0 2100 0> kwN2100;
	pos @GDEF_bases <2000 0 2000 0> kwN2000;
	pos @GDEF_bases <1900 0 1900 0> kwN1900;
	pos @GDEF_bases <1800 0 1800 0> kwN1800;
	pos @GDEF_bases <1700 0 1700 0> kwN1700;
	pos @GDEF_bases <1600 0 1600 0> kwN1600;
	pos @GDEF_bases <1500 0 1500 0> kwN1500;
	pos @GDEF_bases <1400 0 1400 0> kwN1400;
	pos @GDEF_bases <1300 0 1300 0> kwN1300;
	pos @GDEF_bases <1200 0 1200 0> kwN1200;
	pos @GDEF_bases <1100 0 1100 0> kwN1100;
	pos @GDEF_bases <1000 0 1000 0> kwN1000;
	pos @GDEF_bases <950 0 950 0> kwN900;
	pos @GDEF_bases <850 0 850 0> kwN800;
	pos @GDEF_bases <750 0 750 0> kwN700;
	pos @GDEF_bases <650 0 650 0> kwN600;
	pos @GDEF_bases <550 0 550 0> kwN500;
	pos @GDEF_bases <450 0 450 0> kwN400;
	pos @GDEF_bases <350 0 350 0> kwN300;
	pos @GDEF_bases <250 0 250 0> kwN200;
	pos @GDEF_bases <150 0 150 0> kwN100;

	pos @GDEF_bases <-50 0 -50 0> kw100;
	pos @GDEF_bases <-150 0 -150 0> kw200;
	pos @GDEF_bases <-250 0 -250 0> kw300;
	pos @GDEF_bases <-350 0 -350 0> kw400;
	pos @GDEF_bases <-450 0 -450 0> kw500;
	pos @GDEF_bases <-550 0 -550 0> kw600;
	pos @GDEF_bases <-650 0 -650 0> kw700;
	pos @GDEF_bases <-750 0 -750 0> kw800;
	pos @GDEF_bases <-850 0 -850 0> kw900;
	pos @GDEF_bases <-950 0 -950 0> kw1000;
	pos @GDEF_bases <-1050 0 -1050 0> kw1100;
	pos @GDEF_bases <-1150 0 -1150 0> kw1200;
	pos @GDEF_bases <-1250 0 -1250 0> kw1300;
	pos @GDEF_bases <-1350 0 -1350 0> kw1400;
	pos @GDEF_bases <-1450 0 -1450 0> kw1500;
	pos @GDEF_bases <-1550 0 -1500 0> kw1600;
}

do	if AutoKern() != 1; {
	# Standard kerning
	pos @GDEF_bases <2400 0 2400 0> kwN2400;
	pos @GDEF_bases <2300 0 2300 0> kwN2300;
	pos @GDEF_bases <2200 0 2200 0> kwN2200;
	pos @GDEF_bases <2100 0 2100 0> kwN2100;
	pos @GDEF_bases <2000 0 2000 0> kwN2000;
	pos @GDEF_bases <1900 0 1900 0> kwN1900;
	pos @GDEF_bases <1800 0 1800 0> kwN1800;
	pos @GDEF_bases <1700 0 1700 0> kwN1700;
	pos @GDEF_bases <1600 0 1600 0> kwN1600;
	pos @GDEF_bases <1500 0 1500 0> kwN1500;
	pos @GDEF_bases <1400 0 1400 0> kwN1400;
	pos @GDEF_bases <1300 0 1300 0> kwN1300;
	pos @GDEF_bases <1200 0 1200 0> kwN1200;
	pos @GDEF_bases <1100 0 1100 0> kwN1100;
	pos @GDEF_bases <1000 0 1000 0> kwN1000;
	pos @GDEF_bases <900 0 900 0> kwN900;
	pos @GDEF_bases <800 0 800 0> kwN800;
	pos @GDEF_bases <700 0 700 0> kwN700;
	pos @GDEF_bases <600 0 600 0> kwN600;
	pos @GDEF_bases <500 0 500 0> kwN500;
	pos @GDEF_bases <400 0 400 0> kwN400;
	pos @GDEF_bases <300 0 300 0> kwN300;
	pos @GDEF_bases <200 0 200 0> kwN200;
	pos @GDEF_bases <100 0 100 0> kwN100;

	pos @GDEF_bases <-100 0 -100 0> kw100;
	pos @GDEF_bases <-200 0 -200 0> kw200;
	pos @GDEF_bases <-300 0 -300 0> kw300;
	pos @GDEF_bases <-400 0 -400 0> kw400;
	pos @GDEF_bases <-500 0 -500 0> kw500;
	pos @GDEF_bases <-600 0 -600 0> kw600;
	pos @GDEF_bases <-700 0 -700 0> kw700;
	pos @GDEF_bases <-800 0 -800 0> kw800;
	pos @GDEF_bases <-900 0 -900 0> kw900;
	pos @GDEF_bases <-1000 0 -1000 0> kw1000;
	pos @GDEF_bases <-1100 0 -1100 0> kw1100;
	pos @GDEF_bases <-1200 0 -1200 0> kw1200;
	pos @GDEF_bases <-1300 0 -1300 0> kw1300;
	pos @GDEF_bases <-1400 0 -1400 0> kw1400;
	pos @GDEF_bases <-1500 0 -1500 0> kw1500;
	pos @GDEF_bases <-1600 0 -1600 0> kw1600;
}

} DoKerning;

# --- Subtending mark positioning ---

# Based on Scheherazade implementation

lookup SubtendingMarks {
	###lookupflag IgnoreMarks ;
	lookupflag 0;

    # In Graphite we use mark attachment rules. However, in OpenType positioning digits on 
    # subtending marks has to be done with adjustments rather than attachment since for some 
    # engines the digits will ordered *before* the subtending mark.
    
    # Additionally, the adjustment value records depend on font face (e.g. bold vs regular). Therefore
    # we use feax extentions to calculate the value records based on glyph advancewidths and digit AP coordinates.
    
    # In each "do" template, the first rule is ordered for Uniscribe or HarfBuzz 'latin', the second for HarfBuzz 'arab'.

    # Those that take 4 small digits
    do for m = @c_4 ;
       let y = APy(m, "digit") - APy("zero.small", "digitL");
       let w = -ADVx("zero.small"); 
       let x1 = APx(m, "digit") - ADVx(m); 
       let x2 = x1 - w; let x3 = x2 - w; let x4 = x3 - w;
    {
        pos $m  @DigitsAnySmall' <$x1 $y $w 0> @DigitsAnySmall' <$x2 $y $w 0>  @DigitsAnySmall' <$x3 $y $w 0>  @DigitsAnySmall' <$x4 $y $w 0> ;
        pos     @DigitsAnySmall' <$x4 $y $w 0> @DigitsAnySmall' <$x3 $y $w 0>  @DigitsAnySmall' <$x2 $y $w 0>  @DigitsAnySmall' <$x1 $y $w 0> $m ;
    }
    
    # Those that take 3 small digits
    do for m = [ absNumberSign.3 absPageSign.3 absYearSign.3 absSamvat ];  # absFootnoteSign.3
       let y = APy(m, "digit") - APy("zero.small", "digitL");
       let w = -ADVx("zero.small"); 
       let x1 = APx(m, "digit") - ADVx(m); 
       let x2 = x1 - w; let x3 = x2 - w;
    {
        pos $m  @DigitsAnySmall' <$x1 $y $w 0>  @DigitsAnySmall' <$x2 $y $w 0>  @DigitsAnySmall' <$x3 $y $w 0> ;
        pos     @DigitsAnySmall' <$x3 $y $w 0>  @DigitsAnySmall' <$x2 $y $w 0>  @DigitsAnySmall' <$x1 $y $w 0>  $m ;
    }

    # Those that take 3 smaller digits
    do for m = [ absEndOfAyah.3 ] ;	  # disputed end of ayah
       let y = APy(m, "digit") - APy("zero.smaller", "digitL");
       let w = -ADVx("zero.smaller"); 
       let x1 = APx(m, "digit") - ADVx(m); 
       let x2 = x1 - w; let x3 = x2 - w;
    {
        pos $m  @DigitsAnySmaller' <$x1 $y $w 0>  @DigitsAnySmaller' <$x2 $y $w 0>  @DigitsAnySmaller' <$x3 $y $w 0> ;
        pos     @DigitsAnySmaller' <$x3 $y $w 0>  @DigitsAnySmaller' <$x2 $y $w 0>  @DigitsAnySmaller' <$x1 $y $w 0>  $m ;
    }

    # Those that take 2 small digits
    do for m = [ absNumberSign.2 absPageSign.2 absYearSign.2 absFootnoteSign.2 ] ;
       let y = APy(m, "digit") - APy("zero.small", "digitL");
       let w = -ADVx("zero.small"); 
       let x1 = APx(m, "digit") - ADVx(m); 
       let x2 = x1 - w; 
    {
        pos $m  @DigitsAnySmall' <$x1 $y $w 0>  @DigitsAnySmall' <$x2 $y $w 0> ;
        pos     @DigitsAnySmall' <$x2 $y $w 0>  @DigitsAnySmall' <$x1 $y $w 0>  $m ;
    }
    
    # Those that take 2 smaller digits
    do for m = [ absEndOfAyah.2] ;   # disputed end of ayah
       let y = APy(m, "digit") - APy("zero.smaller", "digitL");
       let w = -ADVx("zero.smaller"); 
       let x1 = APx(m, "digit") - ADVx(m); 
       let x2 = x1 - w; 
    {
        pos $m  @DigitsAnySmaller' <$x1 $y $w 0>  @DigitsAnySmaller' <$x2 $y $w 0> ;
        pos     @DigitsAnySmaller' <$x2 $y $w 0>  @DigitsAnySmaller' <$x1 $y $w 0>  $m ;
    }

    # Those that take 1 smaller digit
    do for m = [ absEndOfAyah ] ;   # disputed end of ayah
       let y = APy(m, "digit") - APy("zero.smaller", "digitL");
       let w = -ADVx("zero.smaller"); 
       let x1 = APx(m, "digit") - ADVx(m); 
    {
        pos $m  @DigitsAnySmaller' <$x1 $y $w 0> ;
        pos     @DigitsAnySmaller' <$x1 $y $w 0>  $m ;
    }

    # Those that take 1 small digit (default)
    do for m = [ absNumberSign absPageSign absYearSign absFootnoteSign ] ;
       let y = APy(m, "digit") - APy("zero.small", "digitL");
       let w = -ADVx("zero.small"); 
       let x1 = APx(m, "digit") - ADVx(m); 
    {
        pos $m @DigitsAnySmall' <$x1 $y $w 0> ;
        pos    @DigitsAnySmall' <$x1 $y $w 0> $m ;
    }
 
} SubtendingMarks;


} kern;


feature mark {

# There is ambiguity and overlap among the various attachment classes, so we do the most
# general attachments first, and put the more specific cases last so they override.

@KafTopMarks = [@_kafTop @_kafTop_bj];
lookup AttachKafTop {
		lookupflag UseMarkFilteringSet @KafTopMarks;
#		pos		base gKafMedJm_base		mark @_kafTop_bj;
		pos		base @kafTop					mark @_kafTop;
		pos		base @kafTop_bj				mark @_kafTop_bj;
} AttachKafTop;


@ByShim2_3 = [_byShim2 _byShim3];

lookup AttachByShim1 {		# right-most nuqta (first in stream)
	lookupflag UseMarkFilteringSet @ByShim;

	# If all three shims are used, attach all the way to the right.
	pos nlqBariyehFin' _byShim1' lookup _AttByRight		_byShim2	_byShim3;
	
	# Otherwise, attach mid-right.
	pos nlqBariyehFin' _byShim1' lookup _AttByMidRight;
} AttachByShim1;

lookup AttachByShim2 { # second from bariyeh
	lookupflag UseMarkFilteringSet @ByShim;
	
	# If all three shims are used, attach in the center.
	pos nlqBariyehFin' _byShim1' _byShim2' lookup _AttByCenter2	_byShim3;
	
	# If shims 1 and 2 are used, attach mid-left
	pos nlqBariyehFin' _byShim1' _byShim2' lookup _AttByMidLeft2;
	
	# If shims 2 and 3 are used, attach mid-right.
	pos nlqBariyehFin' _byShim2' lookup _AttByMidRight  _byShim3;
	
	# Otherwise attach to center.
	pos nlqBariyehFin' _byShim2' lookup _AttByCenter2;
	
} AttachByShim2;

lookup AttachByShim3 {		# left-most nuqta when there are 3 (last in stream)
	lookupflag UseMarkFilteringSet @ByShim;
	
	# If all three shims are used, attach to the left.
	pos nlqBariyehFin' _byShim1' _byShim2' _byShim3' lookup _AttByLeft3;
	
	# If 2 shims are used, attach this one mid-left.
	pos nlqBariyehFin' _byShim1' _byShim3' lookup _AttByMidLeft3;
	pos nlqBariyehFin' _byShim2' _byShim3' lookup _AttByMidLeft3;
	
	# Otherwise attach in the center.
	pos nlqBariyehFin' _byShim3' lookup _AttByCenter;
	
} AttachByShim3;


# In case the base doesn't have 'm' APs, use the 'n' ones. This will be overridden if possible.
lookup AttachLowerDiacsLikeNuqtas {
	lookupflag UseMarkFilteringSet @MarkLower;
	pos		base @n1Lower			mark @_mLower;
} AttachLowerDiacsLikeNuqtas;

lookup AttachUpperDiacsLikeNuqtas {
	lookupflag UseMarkFilteringSet @MarkUpper;
	pos		base @nUpper			mark @_mUpper;
} AttachUpperDiacsLikeNuqtas;

lookup AttachLower {
	lookupflag UseMarkFilteringSet @MarkLower;
	pos		base @ring			mark @_ring;		# must be first

	pos		base @n1Lower		mark @_n1Lower;
    pos		base @n23Lower		mark @_n23Lower;
	pos		base @hehhook		mark @_hehhook;
	pos		base @hamzaLower	mark @_hamzaLower;
	pos		base @mLower		mark @_mLower;
} AttachLower;

lookup AttachLower2 {
	lookupflag UseMarkFilteringSet @MarkLower;
	pos		base @tahLower		mark @_tahLower;
} AttachLower2;

lookup AttachMiddle {
	lookupflag UseMarkFilteringSet @MarkMiddle;
	pos		base @squiggle		mark @_squiggle;
	pos		base @bar			mark @_bar;
	pos		base @ring			mark @_ring;
} AttachMiddle;

lookup AttachUpper {
	lookupflag UseMarkFilteringSet @MarkUpper;
    pos		base @nUpper  		mark @_nUpper;
	pos		base @graf			mark @_graf;
} AttachUpper;

lookup AttachHamzaAsUpper {
	#lookupflag UseMarkFilteringSet @MarkUpper;		# was @_hamzaUpper
	lookupflag 0;
	pos		base @nUpper		mark @_hamzaUpper;
	pos		base @mUpper		mark @_hamzaUpper;
} AttachHamzaAsUpper;

lookup AttachUpper2 {
	lookupflag UseMarkFilteringSet @MarkUpper;
	pos		base @alef			mark @_mUpper;
	pos		base @mUpper		mark @_mUpper;
	pos		base @tahUpper		mark @_tahUpper;
	pos		base @hamzaUpper	mark @_hamzaUpper;
} AttachUpper2;

lookup AttachUpper3 {
	lookupflag UseMarkFilteringSet @MarkUpper;
	pos		base @honorific		mark @_honorific;
} AttachUpper3;

# Special cases go last so that they override:
lookup AttachAlefDiacToYeh {
	lookupflag UseMarkFilteringSet @MarkUpper;
	pos		base @alef			mark @_mUpper;
} AttachAlefDiacToYeh;

lookup AttachAlefDiacToLam {
	lookupflag UseMarkFilteringSet @MarkUpper;
	# The rules below were copied from the FEA file autogenerated from the rule below:
	# pos		base @nUpper			mark @_mUpperLam;
	# This is necessary to limit the rules to lams.
	# TODO: simplify this by adding a distinct AP to the lam forms duplicating nUpper.
	
	pos base absLamFin <anchor 1561 2671> mark @_mUpperLam;
	pos base absLamFin._kfTall <anchor 1565 3171> mark @_mUpperLam;
	pos base absLamFin_short <anchor 1555 2471> mark @_mUpperLam;
	pos base absLamIni <anchor 584 2148> mark @_mUpperLam;
	pos base absLamIni.ai <anchor 602 2718> mark @_mUpperLam;
	pos base absLamIni.al <anchor 553 2173> mark @_mUpperLam;
	pos base absLamIni.be <anchor 338 2527> mark @_mUpperLam;
	pos base absLamIni.beM1 <anchor 660 2677> mark @_mUpperLam;
	pos base absLamIni.beM2 <anchor 486 2255> mark @_mUpperLam;
	pos base absLamIni.behg <anchor 539 2148> mark @_mUpperLam;
	pos base absLamIni.benn <anchor 554 2848> mark @_mUpperLam;
	pos base absLamIni.bere <anchor 338 2255> mark @_mUpperLam;
	pos base absLamIni.by <anchor 797 2179> mark @_mUpperLam;
	pos base absLamIni.ch <anchor 204 2625> mark @_mUpperLam;
	pos base absLamIni.fe <anchor 651 2180> mark @_mUpperLam;
	pos base absLamIni.hd <anchor 119 2111> mark @_mUpperLam;
	pos base absLamIni.hgF <anchor 639 2006> mark @_mUpperLam;
	pos base absLamIni.hgM <anchor 207 2151> mark @_mUpperLam;
	pos base absLamIni.jm <anchor 825 3298> mark @_mUpperLam;
	pos base absLamIni.mm <anchor 282 2486> mark @_mUpperLam;
	pos base absLamIni.nn <anchor 395 2841> mark @_mUpperLam;
	pos base [absLamIni.qf absLamIni.snsn] <anchor 350 2442> mark @_mUpperLam;
	pos base absLamIni.re <anchor 461 2461> mark @_mUpperLam;
	pos base absLamIni.sd <anchor 980 2994> mark @_mUpperLam;
	pos base absLamIni.sn <anchor 283 2998> mark @_mUpperLam;
	pos base absLamIni.ta <anchor 1029 2493> mark @_mUpperLam;
	pos base [absLamIni_allah1 absLamMed_allah1] <anchor 524 2092> mark @_mUpperLam;
	pos base absLamIni_short <anchor 754 1618> mark @_mUpperLam;
	pos base absLamMed <anchor 586 2081> mark @_mUpperLam;
	pos base absLamMed.ai <anchor 706 2460> mark @_mUpperLam;
	pos base absLamMed.al <anchor 555 2183> mark @_mUpperLam;
	pos base absLamMed.be <anchor 317 2126> mark @_mUpperLam;
	pos base absLamMed.beF <anchor 589 2245> mark @_mUpperLam;
	pos base absLamMed.beM1 <anchor 668 2599> mark @_mUpperLam;
	pos base absLamMed.beM2 <anchor 503 2329> mark @_mUpperLam;
	pos base absLamMed.be_kfTall <anchor 337 2726> mark @_mUpperLam;
	pos base absLamMed.behg <anchor 564 2119> mark @_mUpperLam;
	pos base absLamMed.benn <anchor 581 2271> mark @_mUpperLam;
	pos base absLamMed.bere <anchor 342 2286> mark @_mUpperLam;
	pos base absLamMed.by <anchor 889 2377> mark @_mUpperLam;
	pos base absLamMed.by_kfTall <anchor 869 2977> mark @_mUpperLam;
	pos base absLamMed.ch <anchor 360 2312> mark @_mUpperLam;
	pos base absLamMed.ch_gfTall <anchor 360 3362> mark @_mUpperLam;
	pos base absLamMed.fe <anchor 603 2304> mark @_mUpperLam;
	pos base absLamMed.hd <anchor 201 2249> mark @_mUpperLam;
	pos base absLamMed.hgF <anchor 574 1969> mark @_mUpperLam;
	pos base absLamMed.hgM <anchor 188 2113> mark @_mUpperLam;
	pos base absLamMed.jm <anchor 983 2234> mark @_mUpperLam;
	pos base absLamMed.mm <anchor 517 2461> mark @_mUpperLam;
	pos base absLamMed.nn <anchor 496 2423> mark @_mUpperLam;
	pos base [absLamMed.qf absLamMed.snsn] <anchor 348 2554> mark @_mUpperLam;
	pos base absLamMed.re <anchor 476 2161> mark @_mUpperLam;
	pos base absLamMed.sd <anchor 983 2427> mark @_mUpperLam;
	pos base absLamMed.sn <anchor 321 2302> mark @_mUpperLam;
	pos base absLamMed.ta <anchor 954 2072> mark @_mUpperLam;
	pos base absLamMed_allah2 <anchor 478 1730> mark @_mUpperLam;
	pos base absLamMed_short <anchor 756 1641> mark @_mUpperLam;
} AttachAlefDiacToLam;

} mark;


@MarkFilter_mUpper	= [@mUpper_MarkBase @_mUpper];
@MarkFilter_mLower	= [@mLower_MarkBase @_mLower];
@MarkFilter_ring	= [@ring_MarkBase   @_ring];

feature mkmk {

lookup Att2ByShimFallBack {
	lookupflag UseMarkFilteringSet [@ByShim @MarkLower];
	pos mark @shim_MarkBase mark @_nByLower;
} Att2ByShimFallBack;

lookup Att2ByShim {
	lookupflag UseMarkFilteringSet [@ByShim @MarkLower];
	pos	mark @shim_MarkBase  	mark @_n1Lower;
	#pos mark @shim_MarkBase	mark @_hehhook;
	pos mark @shim_MarkBase 	mark @_n23Lower;
	pos	mark @shim_MarkBase  	mark @_mLower;
} Att2ByShim;

lookup AttGrafStroke {
	lookupflag 0;
	pos mark @graf_MarkBase		mark @_graf;
} AttGrafStroke;

lookup AttMark2MarkUpper {
	lookupflag UseMarkFilteringSet [@mUpper_MarkBase @_mUpper];
	pos mark @mUpper_MarkBase	mark @_mUpper;
	pos mark @mUpper_MarkBase	mark @_hamzaUpper;
} AttMark2MarkUpper;

# Currently we don't allow anything to attach to honorific diacritics
# like small high ain mark, small high reh-dad, etc.
# Their mUpper AP has been renamed to mUpper2h and we ignore it.
# If any diacritics occur "outside" of them (pathological, I think)
# and want to attach to them, they will attach to the base, which may or
# may not cause collisions depending on the position of the _honorific AP.
# TODO: maybe we should reorder to ensure the honorifics are on the outside.

lookup AttMark2MarkLower {
	lookupflag UseMarkFilteringSet [@mLower_MarkBase @_mLower];
	pos mark @mLower_MarkBase	mark @_mLower;
} AttMark2MarkLower;

# Do we need this?
# lookup AttTah2Mark{
# 	lookupflag UseMarkFilteringSet [@tahUpper_MarkBase @_tahUpper @tahLower_MarkBase @_tahLower];
# 	pos mark @tahUpper_MarkBase	mark @_tahUpper;
# 	pos mark @tahLower_MarkBase	mark @_tahLower;
# } AttTah2Mark;

lookup AttRing2Mark {
	lookupflag UseMarkFilteringSet [@ring_MarkBase @_ring];
	pos mark @ring_MarkBase		mark @_ring;
} AttRing2Mark;


} mkmk;



