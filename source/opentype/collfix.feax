# This file is intended to be included in main.feax.

# Currently these lookups are run within feature calt. Eventually this might be changed to a stylistic set.

lookup KludgeEndOfStream {
	# Ensure that the last nuqta or diacritic has at least three slots after it.
	# This is needed for the insertion rules below.
	ignore sub @IsoFin @Shiftable' @AllBases;  # not at the end
	ignore sub @IsoFin @Shiftable' @Any @Any @Any;
	
	sub @IsoFin  @Shiftable'  @Any @Any		by  @Shiftable  bogus;
	sub @IsoFin  @Shiftable'  @Any			by  @Shiftable  bogus bogus;
	sub @IsoFin	 @Shiftable'  				by  @Shiftable  bogus bogus bogus;
} KludgeEndOfStream;

lookup KludgeEndOfStreamPenultimate {
	# shiftable glyph on penultimate base might need some extra slots:
	ignore sub @Shiftable @IsoFin' @Any @Any;
	sub @Shiftable @IsoFin' @Any			by	@IsoFin bogus;
	sub @Shiftable @IsoFin'					by	@IsoFin bogus bogus;
} KludgeEndOfStreamPenultimate;

lookup CollFixNuqtasUpper {  # some of these rules are generalized to include all marks

	lookupflag UseMarkFilteringSet [@NuqtaVisUpper bogus @KafMed_top_short_sub @KafMed_top_shorter_sub];

	# beh + qaf - put before rule below
	sub absBehMed.qf	@NuqtaVisUpper' lookup _ShiftN500	absQafFin'	@NuqtaVisUpper'  @Any' lookup _ShiftW200;

	# beh + beh
	sub absBehIni.be	@NuqtaVisUpper' lookup _ShiftN300		absBehMed.jm	@NuqtaLikeUpper;
	sub absBehIni.be	@NuqtaVisUpper' lookup _ShiftN200		[absBehMed.fe absBehMed.hd];
	sub absBehIni.be	@NuqtaVisUpper							absBehMed.qf	@NuqtaVisUpper' lookup _ShiftS200;
	sub absBehIni.be	@NuqtaVisUpper' lookup _ShiftN200		absBehMed.sd'	@NuqtaVisUpper' @Any' lookup _ShiftS100W100;

	# NB: lookups that follow @Any operate on the nuqta in the preceding slot, due to the earlier insertion.	  \/ \/ \/
	sub absBehIni.be	@NuqtaVisUpper' lookup _ShiftN200		absBehMed.ta'	@NuqtaVisUpper' 	@Any' lookup _ShiftS100;
	# beh + beh
	sub absBehIni.beM1	@NuqtaVisUpper' lookup _ShiftN200		absBehMed.sn	@NuqtaVisUpper;
	sub absBehIni.beM2	@DotWideU'		 lookup _ShiftN300E200	absBehMed'		absHamzaAbove'	@Any' @Any' lookup _ShiftS100;
	sub absBehIni.beM2	@NuqtaVisUpper' lookup _ShiftN200		absBehMed'		absHamzaAbove'		@Any' lookup _ShiftS100;
	sub absBehIni.beM2	@NuqtaVisUpper' lookup _ShiftN100		absBehMed'		@NuqtaVisUpper'	@Any' lookup _ShiftS100;
	sub absBehIni.beM2	@NuqtaVisUpper' lookup _ShiftN100		absBehMed.benn'	@NuqtaVisUpper'	@Any' lookup _ShiftS100W100;
	sub absBehIni.beM2  @NuqtaVisUpper' lookup _ShiftN200		absBehMed.beM1'	@NuqtaVisUpper' @Any' lookup _ShiftS100;

	sub absBehIni.bere	@DotWideU' lookup _ShiftS100			absBehMed.re' @NuqtaVisUpper' @Any' lookup _ShiftN300W200;

	# beh + kaf
	sub absBehIni.sd	@DotWideU' lookup _ShiftS100E300		[absKehehMed absGafMed];	# round-kaf
	sub absBehIni.sd	@NuqtaVisUpper' lookup _ShiftS100E100	[absKehehMed absGafMed];	# round-kaf
	sub absBehIni.sd	@DotWideU' lookup _ShiftS100E200		[absKehehMed absGafMed];	# round-kaf
	sub absBehIni		@DotFlatL' lookup _ShiftS100			@KehehMedBase_sub  @KafMed_top_short_sub;
	sub absBehIni		@NuqtaVisUpper' lookup _ShiftS300E100	@KehehMedBase_sub  @KafMed_top_short_sub;
	sub absBehIni		@DotTallU' lookup _ShiftS200			@KafMedForms;

	# beh + round kaf

	# beh (teh/theh) + beh + kaf
	#sub absBehMed.beM2	@NuqtaVisUpper' lookup _ShiftS100		absBehMed	@NuqtaVisUpper		@KafMedForms; -- not needed - kaf will be tall
	sub absBehMed.beM2	@NuqtaVisUpper' lookup _ShiftS100		absBehMed						@KafMedForms;

	# initial jeem
	sub [absJeemIni.beM2]	@NuqtaLike		[absBehMed.benn absBehMed.beM1]	@NuqtaVisUpper'	lookup _ShiftN200;
	sub [absJeemIni.beM2]					[absBehMed.benn absBehMed.beM1]	@NuqtaVisUpper'	lookup _ShiftN200;
	sub [absJeemIni.be absJeemIni.bere]	@NuqtaLike		@BehMedForms	@NuqtaVisUpper'	lookup _ShiftN200W100;
	sub [absJeemIni.be absJeemIni.bere]					@BehMedForms	@NuqtaVisUpper'	lookup _ShiftN200W100;

	# jeem (khah) + beh + kaf
	sub @JeemMedForms	@NuqtaVisUpper' lookup _ShiftE100  absBehMed.kf_wide;

	# jeem (initial) + beh (teh)
	sub [absJeemIni.beM2 absJeemIni.behg]  					@BehMedForms @DotWideU' lookup _ShiftN300;
	sub [absJeemIni.beM2 absJeemIni.behg]  @NuqtaVisUpper' lookup _ShiftN200
															@BehMedForms' @DotWideU' @Any' lookup _ShiftN200W100;

	# jeem (medial) + beh (teh/theh)
	sub @JeemMedForms	@NuqtaVisUpper' lookup _ShiftN400E100	@BehMedForms @NuqtaVisUpper;
	# ... in addition to above, shift the beh's nuqta:
	sub absJeemMed.beM1 @NuqtaVisUpper	absBehMed.be  @NuqtaVisUpper' lookup _ShiftW200;

	sub @JeemMedForms	@NuqtaLike	@BehMedForms @DotWideU' lookup _ShiftN400;
	sub @JeemMedForms				@BehMedForms @DotWideU' lookup _ShiftN400;
	sub @JeemMedForms	@NuqtaLike	@BehMedForms @DotNarrowU' lookup _ShiftN200W100;
	sub @JeemMedForms				@BehMedForms @DotNarrowU' lookup _ShiftN200W100;


	# jeem + lam/kaf/alef; NB: when there is a wide nuqta there will be a wide form of the jeem.
	sub absJeemMed		@DotNarrowU' lookup _ShiftE100	[@LamMFForms @KafMFForms absAlefFin];

	# jeem (khah) + sheen + beh																									\/ shifts nuqta on sheen
	sub absJeemMed.sn	@NuqtaVisUpper' lookup _ShiftN100E100	absSeenMed.beM2' @NuqtaVisUpper' absBehMed' @NuqtaVisUpper' lookup _ShiftN200W100;

	# jeem + sheen
	sub absJeemMed.sn					[@SeenMedForms @SeenIniForms]	@DotWideU' lookup _ShiftW300;
	sub absJeemMed.sn	@NuqtaLikeUpper	[@SeenMedForms @SeenFinForms]	@DotWideU' lookup _ShiftW300;

	# jeem + qaf
	sub [absJeemIni.qf absJeemMed.qf]	@NuqtaVisUpper	absQafFin	@NuqtaVisUpper' lookup _ShiftW200;
	sub [absJeemIni.qf absJeemMed.qf]					absQafFin	@NuqtaVisUpper' lookup _ShiftW200;

	# feh                                 \/ \/ \/ use ' to parallel and override rule below
	sub [absFehIni.be absFehIni.beM2]	@NuqtaVisUpper'						absBehMed.jm'	@NuqtaVisUpper' lookup _ShiftW300;
	sub [absFehIni.be absFehIni.beM2]										absBehMed.jm	@NuqtaVisUpper' lookup _ShiftW300;
	sub [absFehIni.be absFehIni.beM2]	@NuqtaVisUpper' lookup _ShiftN200	@BehMedForms'	@NuqtaVisUpper' @Any' lookup _ShiftN500W100;

	sub absBehMed.fe @DotWideU	absFehMed @DotWideU' lookup _ShiftN200E100	@LamMFForms;
	sub 						absFehMed @DotWideU' lookup _ShiftE100		@LamMFForms;
	# Doesn't work, and maybe not needed.
	#sub absFehIni.kf_wide	@DotWideU' lookup _ShiftE100 @KafForms;  # I don't think we need to includes lam and alef forms.

	sub absFehIni.qf @NuqtaVisUpper  absQafFin @NuqtaVisUpper' lookup _ShiftW200;

	sub absFehMed.beM2 @NuqtaLikeUpper	absBehMed @NuqtaVisUpper'  lookup _ShiftN200;
	sub absFehMed.beM2					absBehMed @NuqtaVisUpper'  lookup _ShiftN200;

	# seen + beh
	sub [absSeenIni.be absSeenMed.be absSeenIni.beM2 absSeenMed.beM2]
						@NuqtaVisUpper' lookup _ShiftN100E200	[absBehMed absBehMed.jm absBehMed.mm]	@NuqtaVisUpper;
	sub absSeenIni.bere @NuqtaVisUpper' lookup _ShiftN200E100		absBehMed.re'	@DotWideU'	@Any'	lookup _ShiftS200W100;
	# avoid straight line
	sub absSeenIni.behg @NuqtaVisUpper' lookup _ShiftN200 absBehMed.hgF @NuqtaVisUpper;

	# sheen + jeem
	sub absSeenIni.jm  @NuqtaVisUpper' lookup _ShiftE300	absJeemMed.beM1  @NuqtaVisUpper;

	# tah
	sub absBehMed.ta	@NuqtaVisUpper		@TahMedForms	@NuqtaVisUpper' lookup _ShiftN100;
	sub absBehMed.ta	@NuqtaVisUpper		@TahFinForms	@NuqtaVisUpper' lookup _ShiftN300;

} CollFixNuqtasUpper;

lookup CollFixNuqtasLower {
	lookupflag UseMarkFilteringSet [@NuqtaLikeLower bogus];

	# beh + beh																								#	  \/ \/ \/
	# NB: lookups that follow @Any operate on the nuqta in the preceding slot, due to the earlier insertion.	  \/ \/ \/
																											#	  \/ \/ \/
	sub absBehIni.beM2	@NuqtaLikeLower' lookup _ShiftN100		absBehMed'		@NuqtaLikeLower' 	@Any' lookup _ShiftS200;
	sub absBehIni.beM2	@NuqtaLikeLower' lookup _ShiftN100		absBehMed.benn'	@NuqtaLikeLower' 	@Any' lookup _ShiftS200;

	ignore sub absBehIni.be _dot1l'								absBehMed.beF' _dot1l'				@Any';
	sub absBehIni.be	@NuqtaLikeLower' lookup _ShiftN100		absBehMed.beF'	@NuqtaLikeLower'	@Any' lookup _ShiftS200;
	sub absBehMed.be	@NuqtaLikeLower' lookup _ShiftN100E200	absBehMed.jm'	@NuqtaLikeLower'	@Any'@Any' lookup _ShiftS200W200;
	sub absBehIni.be	@DotTallL'		 lookup _ShiftN200E200	absBehMed.hgM'	@DotWideL'			@Any' @Any' lookup _ShiftS300;
	sub absBehIni.be	@NuqtaLikeLower' lookup _ShiftN200E200	absBehMed.hgM'	@DotWideL'			@Any' @Any' lookup _ShiftS200;
	sub absBehIni.be	@NuqtaLikeLower' lookup _ShiftN200E100	absBehMed.hgM'	@NuqtaLikeLower'	@Any' @Any' lookup _ShiftS200;
	sub absBehIni.be	@NuqtaVisLower'  lookup _ShiftN100		absBehMed.ai'	@NuqtaVisLower'		@Any' lookup _ShiftS400W300;
	sub absBehIni.be    @NuqtaLikeLower' lookup _ShiftN100		absBehMed.fe'	@NuqtaLikeLower'	@Any' lookup _ShiftS200;
	sub absBehIni.be	@DotTallL' 		 lookup _ShiftN100		absBehMed.qf'	@NuqtaLikeLower'	@Any' lookup _ShiftS300;
	sub absBehIni.be	@NuqtaLikeLower' lookup _ShiftN100		absBehMed.qf'	@NuqtaLikeLower'	@Any' lookup _ShiftS100;

	sub absBehIni.beM1	@DotWideL'       lookup _ShiftN200		absBehMed.beM2'	@NuqtaLikeLower'	@Any' lookup _ShiftS200;
	sub absBehIni.beM1	@NuqtaLikeLower' lookup _ShiftN200		absBehMed.beM2'	@DotWideL'			@Any' lookup _ShiftS200;
	sub absBehIni.beM1	@NuqtaLikeLower' lookup _ShiftN200		absBehMed.sn'	@NuqtaLikeLower'	@SeenMFForms' lookup _ShiftS500 @NuqtaLikeLower;
	sub absBehIni.beM1	@NuqtaLikeLower' lookup _ShiftN200		[absBehMed.be absBehMed.sn]'
																				@NuqtaLikeLower'	[@BehMFForms @SeenMFForms]' lookup _ShiftS400W200;
	sub absBehIni.beM2	@DotWideL'		 lookup _ShiftN200E300	absBehMed.beM1'	@NuqtaLikeLower'	@Any' @Any' lookup _ShiftS200;
	sub absBehIni.beM2	@NuqtaLikeLower' lookup _ShiftN200E200	absBehMed.beM1'	@NuqtaLikeLower'	@Any' @Any' lookup _ShiftS200;
	sub absBehIni.beM2	@NuqtaLikeLower' lookup _ShiftE100		absBehMed'		@NuqtaLikeLower'	@Any' lookup _ShiftS100;

	sub absBehIni.benn	_dot1l'          lookup _ShiftN100		absBehMed.nn'	_dot1l'				@Any' lookup _ShiftS300;
	sub absBehIni.benn	@NuqtaLikeLower' lookup _ShiftN100		absBehMed.nn'	@NuqtaLikeLower'	@Any' lookup _ShiftS400;
	sub absBehIni.bere	@NuqtaLikeLower' lookup _ShiftN100		absBehMed.re'	@DotWideL'			@Any' lookup _ShiftS200W200;
	sub absBehIni.bere	@NuqtaLikeLower' lookup _ShiftN100		absBehMed.re'	@NuqtaLikeLower'	@Any' lookup _ShiftS200W100;
	sub absBehMed.bere	@NuqtaLikeLower' lookup _ShiftE200		absBehMed.re'	@NuqtaLikeLower' 	@Any' lookup _ShiftS400;

	sub absBehIni.beM2	@NuqtaLikeLower							absBehMed.benn'	@NuqtaLikeLower' lookup _ShiftS200W200;
	sub absBehIni.be	@NuqtaLikeLower' lookup _ShiftN100		absBehMed.mmX'	@NuqtaLikeLower' absMeemMed._alt' lookup _ShiftS200W200;
	sub absBehMed.benn	_dot1l									absBehMed.nn	_dot1l'			 lookup _ShiftS200;
	sub absBehMed.benn	@NuqtaLikeLower						absBehMed.nn_hgbm	@NuqtaLikeLower' lookup _ShiftS300;

	# beh + beh + medial jeem

	sub absBehIni.be	@DotWideL' lookup _ShiftE100	absBehMed.jm	[absJeemMed.qf absJeemMed.hd];
	sub absBehIni.be	@DotWideL' lookup _ShiftN400E400
										absBehMed.jm' @NuqtaLikeLower' [absJeemMed.qf absJeemMed.hd]' @Any' lookup _ShiftS200W200;
	sub absBehIni.be	@NuqtaLikeLower' lookup _ShiftN100E200
										absBehMed.jm' @NuqtaLikeLower' @JeemMedForms' @Any' lookup _ShiftS300;

	# beh + beh + final jeem																												# \/ affects middle nuqta due to insertions
	sub absBehIni.be	@DotFlatL' lookup _ShiftN200E300	absBehMed.jm'	@DotFlatL'	absJeemFin' @NuqtaLikeLower' lookup _ShiftS200;
	sub absBehIni.be	@DotTallL' lookup _ShiftN500E500	absBehMed.jm'	@DotFlatL'	absJeemFin' @NuqtaLikeLower' lookup _ShiftS200;
	sub absBehIni.be	@DotFlatL' lookup _ShiftN300E300	absBehMed.jm'	@DotTallL'	absJeemFin' @NuqtaLikeLower' lookup _ShiftS100;
	sub absBehIni.be	@DotTallL' lookup _ShiftN500E500	absBehMed.jm'	@DotTallL'	absJeemFin	@NuqtaLikeLower;
	# more below in CollFixNuqtas_3rd

	# beh + lam (final)
	sub [absBehIni] @NuqtaLikeLower' lookup _ShiftE100	absLamFin;

	# beh + lam + chotiyeh
	sub absBehIni @NuqtaLikeLower' lookup _ShiftN100E200	absLamMed.ch;

	# beh + lam + beh
	sub absBehIni @DotTallL' lookup _ShiftN200		absLamMed.be	absBehMed.qf @DotWideL;

	# beh + kaf + chotiyeh
	sub absBehIni	@NuqtaLikeLower' lookup _ShiftN100E300		[absKehehMed.ch absGafMed.ch absKehehMed.ch_base absLamMed.ch];

	# beh + kaf + heh-do
	sub absBehIni	@NuqtaLikeLower' lookup _ShiftS200E100	[absKehehMed.hd absGafMed.hd absKehehMed.hd_base absLamMed.hd];

	# beh + heh-goal
	sub absBehIni.hgM	@DotWideL' lookup _ShiftE200	@HehGoalMedForms'	_hehHook.small' @Any' lookup _ShiftS200;

	# jeem + beh
	sub [absJeemIni.benn absJeemMed.benn]	@NuqtaLower' lookup _ShiftN100		
															absBehMed.nn'	@NuqtaLikeLower' @Any' lookup _ShiftS400;
	sub [absJeemIni.bere absJeemMed.bere]	@NuqtaLower		absBehMed.re	@NuqtaLikeLower' lookup _ShiftS300;

	# medial jeem + final jeem
	sub absJeemMed.jm	@DotFlatL' lookup _ShiftE200	absJeemFin;
	sub absJeemMed.jm	@DotTallL' lookup _ShiftE300	absJeemFin;

	# feh

	sub absFehIni.hd	@NuqtaLikeLower' lookup _ShiftE200	@HehDoForms;
	sub absFehIni.jm	@NuqtaLikeLower' lookup _ShiftE200	@JeemForms;

	sub absFehIni.beM1	@NuqtaLikeLower' lookup _ShiftN100	absBehMed.be' 		@NuqtaLikeLower'	@Any' lookup _ShiftS200;
	sub absFehIni.hgM	@NuqtaLikeLower' lookup _ShiftE100	@HehGoalMedForms'	_hehHook.small'		@Any' lookup _ShiftW100;

	# heh-goal + chotiyeh
	sub absHehGoalIni.benn	_hehHook.small	absBehMed.nn_hgbm	@NuqtaLikeLower' lookup _ShiftS500W100;

	# heh-goal + lam + chotiyeh
	sub absHehGoalIni		_hehHook.small' lookup _ShiftE100	[absLamMed.ch absKehehMed.ch absGafMed.ch absKehehMed.ch_base];
	sub absHehGoalIni.jm	_hehHook.small' lookup _ShiftE200;

	# reh overhang

	####sub absRehFin  absBehIni.ch @NuqtaLikeLower' lookup _ShiftS300;

} CollFixNuqtasLower;

lookup CollFixLowerBariyeh {
	lookupflag UseMarkFilteringSet [@NuqtaLikeLower @ByShim];

	sub _byShim1 @DotWideL' lookup _ShiftE200	_byShim2 @DotWideL;
	sub _byShim2 @DotWideL						_byShim3 @DotWideL' lookup _ShiftW200 ;

} CollFixLowerBariyeh;

# Adjust the third item in the sequence.
lookup CollFixNuqtas_3rd {
	lookupflag UseMarkFilteringSet [@NuqtaLikeLower];

	sub absBehIni.be  @NuqtaLikeLower		absBehMed.jm  @NuqtaLikeLower	absJeemFin	@DotTallL' lookup _ShiftS100;
	sub absBehIni.be  @NuqtaLikeLower		absBehMed.jm  @DotTallL			absJeemFin	@NuqtaLikeLower' lookup _ShiftS200;
	sub absBehIni.be  @NuqtaLikeLower		absBehMed.jm  @NuqtaLikeLower	absJeemFin	@NuqtaLikeLower' lookup _ShiftS100;

	# (beh +) beh + heh-goal - the dots on the second beh have already been moved down:
	sub absBehMed.hgM  @DotWideL  @HehGoalMedForms  _hehHook.small' lookup _ShiftW100;

	# (beh +) beh + jeem + heh-doachashmee - the dots on the second beh have already been moved down:
	sub absBehMed.jm @NuqtaLikeLower absJeemMed.hd  @NuqtaLikeLower' lookup _ShiftS300W100  @HehDoForms;

} CollFixNuqtas_3rd;

lookup CollFixDiacUpper {
	lookupflag UseMarkFilteringSet [@NuqtaVisUpper @DiacUpper @KafMed_top_tall_sub bogus];  # bogus matches kludged slot

	# alef
	sub absAlef  @DiacUpper' lookup _ShiftN200E100  [absKehehIni absGafIni];
	# alef + feh
	sub @AlefForms @MarkUpper	@FehIniForms @DotWideU' lookup _ShiftW200  @Finals;

	# beh + kaf

	sub [absBehIni absBehMed absBehMed.kf_wide]  @DotFlatU' lookup _ShiftS200
				@DiacUpper'  [@KafMFForms @KafMedBase_sub]' lookup _ShiftS100E100;
	sub [absBehIni absBehMed absBehMed.kf_wide]  @NuqtaVisUpper' lookup _ShiftS200
				@DiacUpper'  [@KafMFForms @KafMedBase_sub]' lookup _ShiftS200E200;
	sub absBehIni @NuqtaVisUpper' lookup _ShiftS200E100	@DiacUpper
							@KafMedBaseT_sub @KafMed_top_tall_sub;
	sub [absBehMed absBehMed.kf_wide]  @NuqtaVisUpper' lookup _ShiftS200	@DiacUpper
							@KafMedBaseT_sub @KafMed_top_tall_sub;


	# beh cont'd.

	sub absBehIni.jm  @DiacUpper' lookup _ShiftN200E200		@JeemMedForms @MarkUpper;

	sub absBehIni.beM2  @NuqtaLikeUpper' lookup _ShiftS100	absBehMed'  @Diac' @Any'  lookup _ShiftN500;

	sub absBehIni.bere  @NuqtaLikeUpper' lookup _ShiftS100	absBehMed.re' @Diac' @Any' lookup _ShiftN200W100;

	# jeem
	sub absJeemMed	@DiacUpper'	lookup _ShiftE200		[absAlefFin @LamMedForms @LamFinForms @KafMedForms @KafFinForms @KafMedBase_sub];

	# ain + meem
	sub [absAinIni.mm absAinMed.mm]				[@MeemMedForms absMeemFin]  @Diac' lookup _ShiftW300 [@LamMFForms absAlefFin @KafMFForms];
	sub [absAinIni.mm absAinMed.mm] @MarkUpper	[@MeemMedForms absMeemFin]  @Diac' lookup _ShiftW300 [@LamMFForms absAlefFin @KafMFForms];
	sub [absAinIni.mm absAinMed.mm]				[@MeemMedForms absMeemFin]  @Diac' lookup _ShiftW400;
	sub [absAinIni.mm absAinMed.mm] @MarkUpper  [@MeemMedForms absMeemFin]	@Diac' lookup _ShiftW400;

	# lam + beh + kaf
	sub @LamIniForms @DiacUpper' lookup _ShiftS100E100  @BehMedForms 						@KafFinForms;
	sub @LamIniForms @DiacUpper' lookup _ShiftS100E100  @BehMedForms @MarkUpper				@KafFinForms;
	sub @LamIniForms @DiacUpper' lookup _ShiftS100E100  @BehMedForms @MarkUpper @MarkUpper	@KafFinForms;

	# meem
	sub absMeemIni.mm  @DiacUpper' lookup _ShiftS200E200			absMeemMed  @KehehMedForms;

	sub absMeemIni.beM1  @DiacUpper' lookup _ShiftE100				absBehMed.beM2' @NuqtaVisUpper' @Any' lookup _ShiftW200;
	sub absMeemIni.beM1  @DiacUpper' lookup _ShiftE100 @DiacUpper'	absBehMed.beM2' @NuqtaVisUpper' @Any' lookup _ShiftW200;

	sub absLamIni.mm  @MeemMedForms  @DiacUpper' lookup _ShiftW400;
	sub [absKehehIni.mm absGafIni.mm]  @MeemMedForms  @DiacUpper' lookup _ShiftS100W400;

	# meem + feh
	sub absMeemMed.fe @DiacUpper' lookup _ShiftN200;

	# feh + dal
	sub absFehMed @NuqtaVisUpper	absDalFin @DiacUpper' lookup _ShiftN200;

} CollFixDiacUpper;

@LamKafBeLowTooth = [absLamMed.be absKehehMed.be absGafMed.be absKehehMed.be_base 
	absLamMed.beM2 absKehehMed.beM2 absGafMed.beM2 absKehehMed.beM2_base];

lookup CollFixDiacLower {
	lookupflag UseMarkFilteringSet [@NuqtaLikeLower @DiacLower bogus];  # bogus matches kludged slot

	# zair + nuqta
	sub [absKehehIni.beM1 absGafIni.beM1 absKehehIni.beM1_base absBehIni.beM1]
						@DiacLower' lookup _ShiftN100			@BehMedForms'  @NuqtaLikeLower' @Any' lookup _ShiftS300;
	sub absLamIni.beM1	@DiacLower' lookup _ShiftN200E200		@BehMedForms'  @NuqtaLikeLower' @Any' @Any' lookup _ShiftS400;
	sub absFehIni.be	@DiacLower' lookup _ShiftN200E100		absBehMed.mm'  @NuqtaLikeLower' @Any' @Any' lookup _ShiftS300;
	sub [absFehMed.be absBehMed.be]
						@DiacLower' lookup _ShiftN100E100		absBehMed.mm'  @NuqtaLikeLower' @Any' @Any' lookup _ShiftS300;

	# something + diac + beh/yeh (common in Urdu)
	sub @NuqtaLikeLower @DiacLower' lookup _ShiftS500E100 absBehMed.qf  @NuqtaLikeLower;
	sub                 @DiacLower' lookup _ShiftS700E100 @BehMedForms  @NuqtaLikeLower;

	# beh + jeem
	sub [absBehIni.jm absBehMed.jm]  @NuqtaLikeLower  @DiacLower' lookup _ShiftN200E300  absJeemFin @NuqtaLikeLower;

	# beh + lam/kaf, lam/kaf + beh
	sub [absBehIni absBehMed]  @NuqtaLikeLower	@LamKafBeLowTooth  @DiacLower' lookup _ShiftS700;
	sub @LamKafBeLowTooth @DiacLower' lookup _ShiftS700  absBehMed.qf @NuqtaLikeLower;

	sub absBehMed @NuqtaLikeLower  [@LamMedForms @KafMedForms]  @DiacLower' lookup _ShiftS400;

	# seen + jeem
	sub @SeenIMForms  @DiacLower' lookup _ShiftE200 @JeemMedForms;

	# feh
	sub absFehIni.be @DiacLower' lookup _ShiftS400  absBehMed.sd'  @NuqtaLikeLower' @Any' lookup _ShiftW200;

	# meem
	sub absMeemIni.benn  @DiacLower' lookup _ShiftS500E200	absBehMed.nn_hgbm  @NuqtaLikeLower;

	# alef + beh + chotiyeh
	sub @AlefForms	absBehIni.ch @MarkLower' lookup _ShiftS200;

} CollFixDiacLower;

lookup MergeShifts {
	lookupflag UseMarkFilteringSet @CfMarker;
	sub cfS100 cfS100	by	cfS200;
} MergeShifts;


# Rules that take existing adjustments into account

lookup CollFixNuqtasUpperNextAdjustment {
	lookupflag UseMarkFilteringSet [@MarkUpper @CfMarker @KafMed_top_tall_sub];

	# hah+3dots + beh+digit - move digit down
	sub absJeemMed.beM2  @NuqtaVisUpper @CfMarker	absBehMed.kf_wide  [_smallTwoAbove _smallThreeAbove]' lookup _ShiftS200W100;

	# beh + beh (+ qaf) - move first nuqta down
	sub absBehIni.be  @NuqtaVisUpper' lookup _ShiftS200		absBehMed.qf  @NuqtaVisUpper @CfMarkerN;

	# beh + hamza + diac + kaf
	sub absBehIni absHamzaAbove @CfMarkerS  @DiacUpper' lookup _ShiftS100E200  @KafMedForms;

	# beh + kaf
	sub absBehIni @NuqtaVisUpper @CfMarkerS @Diac cfS200' @KafMedBase_sub @KafMed_top_tall_sub	by  cfS100;

	# (lam +) meem + feh
	sub absMeemMed.fe @DiacUpper' lookup _ShiftN200 @CfMarkerW	absFehMed  @DotWideU;

} CollFixNuqtasUpperNextAdjustment;

lookup CollFixNuqtasLowerNextAdjustment {
	lookupflag UseMarkFilteringSet [@MarkLower @CfMarker];

	# beh + beh
	sub absBehIni.be @NuqtaLikeLower cfN200 @CfMarkerE @DiacLower' lookup _ShiftS300	absBehMed.hgM @NuqtaLikeLower @CfMarkerS;

	# yeh + yeh - avoid a flat line
	sub absBehMed.beM2  _dot2l  @CfMarkerS		absBehMed  _dot2l' lookup _ShiftS200;

} CollFixNuqtasLowerNextAdjustment;

# Tweak fixes using simple substitution
lookup CollFixRedoLower {
	lookupflag UseMarkFilteringSet [@MarkLower @CfMarker];

	sub [absKehehIni.benn absGafIni.benn] @DiacLower cfS700' @CfMarkerE absBehMed.nn @NuqtaLikeLower	by	cfS400;

	# beh + yeh + noon + yeh
	sub absBehIni.beM1 @MarkLower @CfMarker absBehMed.be @NuqtaLikeLower @CfMarkerS cfW200' absBehMed.ch	by  cfW100;

} CollFixRedoLower;

lookup CollFixNameMarker {

	lookupflag UseMarkFilteringSet [absNameMarker];

	# Jesus: yeh seen waw ain
	sub absBehIni.sn absSeenMed.qf absWawFin._stfh absAin absNameMarker' lookup _ShiftS300E100;

	# Enoch: jeem beh waw jeem
	sub absJeemIni.be absBehMed.qf absWawFin absKhah absNameMarker' lookup _ShiftS100E300;

	# Hagar: [heh-goal alef] gaf alef reh
	sub absGafIni absAlefFin absReh absNameMarker' lookup _ShiftN300;

	# sheen meem
	sub absSeenIni.mm absMeemFin  absNameMarker' lookup _ShiftN500W400;

	# lam jeem meem
	sub absLamIni.jm absJeemMed.mm absMeemFin  absNameMarker' lookup _ShiftN400W300;

	# Lot: lam waw tah
	sub absLamIni.qf absWawFin absTah absNameMarker' lookup _ShiftE200;

	# Pharaoah: [feh reh] ain waw heh-goal
	sub absAinIni.qf absWawFin absHehGoal absNameMarker' lookup _ShiftE300;

	# Nahor: [noon alef] hah waw reh
	sub absJeemIni.qf absWawFin absNameMarker' lookup _ShiftN200;

	# Naphtuhim: [noon feh teh waw] hah yeh meem
	sub absJeemIni.be absBehMed.mm absNameMarker' lookup _ShiftN200;

	# Noah: beh waw jeem alef
	sub absBehIni.qf absWawFin absJeemIni absNameMarker' lookup _ShiftN200E400 absAlefFin;

	# Sarah: [seen alef] reh heh-goal
	sub absReh absHehGoal absNameMarker' lookup _ShiftE300;

	# Shalam: [sheen alef] lam meem
	sub absLamIni.mm absMeemFin absNameMarker' lookup _ShiftN500;

	# Tamar: [teh alef] meem alef reh
	sub absMeemIni absAlefFin absReh  absNameMarker' lookup _ShiftN400E100;

	# Zohar: dad jeem reh
	sub absSadIni.jm absJeemMed.re absRehFin absNameMarker' lookup _ShiftN300;

} CollFixNameMarker;

lookup CollFixMarkNameMarker {
	lookupflag 0;  #UseMarkFilteringSet [@Mark];  # ignore bogus

	# [ain reh] feh heh-goal
	sub absFehIni.hgF @NuqtaLikeUpper' lookup _ShiftS200	absHehGoalFin'  absNameMarker' @Any' lookup _ShiftN700E400;

	# Boaz: [beh waw] ain zain 
	sub absAinIni.re absRehFin @NuqtaLikeUpper absNameMarker' lookup _ShiftE300;

	# Eve: hah waw shadda alef
	sub absJeemIni.qf absWawFin absShadda' lookup _ShiftN200 absAlef' absNameMarker' @Any' lookup _ShiftE400;

	# Gaza: ghain zain heh-goal
	sub absAinIni.re _dot1u absRehFin _dot1u' lookup _ShiftS200 absShadda' absHehGoal' absNameMarker'; ## @Any' lookup _ShiftN400E400;

	# Rebekah [reh] beh qaf heh-goal
	sub absBehIni.fe _dot1l absFehMed.hgF _dot2u' lookup _ShiftS200 absHehGoalFin' absNameMarker' @Any' lookup _ShiftN700E300;

	# Rehoboth: [reh hah waw beh] waw teh heh-do
	sub absWawFin absBehIni.hd _dot2u' lookup _ShiftS200 absHehDoachashmeeFin' absNameMarker' @Any' lookup _ShiftN500E300;

	# Sabbath: [seen beh] teh heh-goal
	sub absBehMed.hgF_be _dot2u' lookup _ShiftS200 absHehGoalFin' absNameMarker' @Any' lookup _ShiftN400E400;

	# Zeboyim: [dad beh waw] yeh-hamza yeh meem
	sub absBehIni.be absHamzaAbove' lookup _ShiftS200 absBehMed.mm' _dot2l' absMeemFin' absNameMarker' @Any' lookup _ShiftN500;

	# Zoar: [dad] ain zabar reh
	sub absAinMed.re nlqZabar' lookup _ShiftS100 absRehFin' absNameMarker' @Any' lookup _ShiftN700;

} CollFixMarkNameMarker;

lookup CollFixMarkNameMarkerContd {
	lookupflag UseMarkFilteringSet [absNameMarker @Mark];

	# Why can't I do all this in one rule??? It should work.!
	# Gaza: ghain zain heh-goal
	sub absAinIni.re _dot1u absRehFin _dot1u absShadda absHehGoal absNameMarker' lookup _ShiftN400E400;

} CollFixMarkNameMarkerContd;


lookup EndOfStreamUndoKludge {
	sub bogus  by  NULL;
} EndOfStreamUndoKludge;