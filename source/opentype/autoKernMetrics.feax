#	File: autoKernMetrics.feax
#
#	FEAX code for Awami Nastaliq font

# lookup InitKernMetrics:
do	if SliceWidth() == 200;
	{

	ifinfo(styleName, "Regular|Medium") {
		include(../../source/opentype/autoKernMetrics-R-200.feax);
	}
	ifinfo(styleName, "Bold") {				# SemiBold, Bold, ExtraBold
		include(../../source/opentype/autoKernMetrics-B-200.feax);
	}

	}

	
do	if SliceWidth() == 100;
	{
		include(../../source/opentype/autoKernMetrics-100.feax);
	}
