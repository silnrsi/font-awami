lookup _DeleteShim {
	# Replacing with NULL does not work in MS Word. Do we need to do this?
	sub _byShim1  by  bogus;
	sub _byShim2  by  bogus;
	sub _byShim3  by  bogus;
} _DeleteShim; 


# Allah ligature

lookup _AllahSub_Alef {
    sub @AlefNoAllah  by  @AlefAllah;
} _AllahSub_Alef ;

lookup _AllahSub_Lam1 {
    sub @Lam1NoAllah  by  @Lam1Allah;
} _AllahSub_Lam1 ;

lookup _AllahSub_Lam2 {
    sub absLamMed     by absLamMed_allah2;
} _AllahSub_Lam2 ;

lookup _AllahSub_Lam2_insertSA {    # insert shadda-alef
	lookupflag 0;
	sub absLamMed  by  absLamMed_allah2  _shadda_kharizabar;  # the Allah form of the shadda+alef is created later in ShaddaAlefLigatures
} _AllahSub_Lam2_insertSA ;

lookup _AllahSub_Heh {
    sub @HehNoAllah  by  @HehAllah;
} _AllahSub_Heh ;

lookup _AllahSub_SAHeh {
    # This rule is the same as previous but handles the case where a shadda-alef glyph has been inserted.
    # Inserted glyphs result in the target lookup being applied to the inserted glyph instead of the heh that follows.
    sub _shadda_kharizabar' @HehNoAllah' lookup _AllahSub_Heh;
} _AllahSub_SAHeh;

lookup _AllahSub_Shadda_insertA {
    sub absShadda     by   _shadda_kharizabar;  # the Allah form of the shadda+alef is created later in ShaddaAlefLigatures
} _AllahSub_Shadda_insertA ;


# Subtending mark digits

lookup _SignWith_4digits {
	lookupflag IgnoreMarks ;
	sub @cno_4 by @c_4 ;
} _SignWith_4digits ;

lookup _SignWith_3digits {
	lookupflag IgnoreMarks ;
	sub @cno_3 by @c_3 ;
} _SignWith_3digits ;

lookup _SignWith_2digits {
	lookupflag IgnoreMarks ;
	sub @cno_2 by @c_2 ;
} _SignWith_2digits ;

lookup _SignDigits_ToSmall {
	lookupflag IgnoreMarks ;
	sub @DigitsAny by @DigitsAnySmall ;
} _SignDigits_ToSmall ;

lookup _SignDigits_ToSmaller {
	lookupflag IgnoreMarks ;
	sub @DigitsAny by @DigitsAnySmaller ;
} _SignDigits_ToSmaller ;
