lookup _DelYt {
    sub @YtMarker	by   NULL;
	sub @YtkMarker	by	NULL;
} _DelYt;

lookup _DelYb {
	sub @YbMarker	by	NULL;
} _DelYb;

@YbLow = [yb0 ybN100 ybN200 ybN300 ybN400 ybN500 ybN600 ybN700 ybN800 ybN900 ybN1000
	ybN1100 ybN1200 ybN1300 ybN1400 ybN1500];

# A block occurs when the yt (top) value is too close to the yb (bottom) value.
# Currently we want a space of at least 200 units.

# lookup _TestBlockI..., _TestBlockR...

do	forlet i = range(0,2);
	let lnames = ["_TestBlockR","_TestBlockI"];
	let lname = lnames[i];
	let kbGlyphs = feaclass('KBlock');
	let kb = kbGlyphs[i];  # kblockI, kblockR
{
lookup $lname {
	lookupflag UseMarkFilteringSet [@YtMarker @YtkMarker @YbMarker];

	# bottom = -100; any top lower than 100 creates a block
	sub [ytN100 ytkN100]' @YbLow	by $kb;
	sub [ytN100 ytkN100]' yb100		by $kb;

	# bottom = 0; any top lower than 200 creates a block
	sub [yt0 ytk0]'	@YbLow			by	$kb;
	sub [yt0 ytk0]'	yb100			by	$kb;
	sub [yt0 ytk0]'	yb200			by	$kb;

	# bottom = 100; any top lower than 300 creates a block
	sub [yt100 ytk100]'	@YbLow		by	$kb;
	sub [yt100 ytk100]'	yb100		by	$kb;
	sub [yt100 ytk100]'	yb200		by	$kb;
	sub [yt100 ytk100]'	yb300		by	$kb;

	sub [yt200 ytk200]'	@YbLow		by	$kb;
	sub [yt200 ytk200]'	yb100		by	$kb;
	sub [yt200 ytk200]'	yb200		by	$kb;
	sub [yt200 ytk200]'	yb300		by	$kb;
	sub [yt200 ytk200]'	yb400		by	$kb;

	sub [yt300 ytk300]'	@YbLow		by	$kb;
	sub [yt300 ytk300]'	yb100		by	$kb;
	sub [yt300 ytk300]'	yb200		by	$kb;
	sub [yt300 ytk300]'	yb300		by	$kb;
	sub [yt300 ytk300]'	yb400		by	$kb;
	sub [yt300 ytk300]'	yb500		by	$kb;

	sub [yt400 ytk400]'	@YbLow		by	$kb;
	sub [yt400 ytk400]'	yb100		by	$kb;
	sub [yt400 ytk400]'	yb200		by	$kb;
	sub [yt400 ytk400]'	yb300		by	$kb;
	sub [yt400 ytk400]'	yb400		by	$kb;
	sub [yt400 ytk400]'	yb500		by	$kb;
	sub [yt400 ytk400]'	yb600		by	$kb;

	sub [yt500 ytk500]'	@YbLow		by	$kb;
	sub [yt500 ytk500]'  yb100		by	$kb;
	sub [yt500 ytk500]'  yb200		by	$kb;
	sub [yt500 ytk500]'  yb300		by	$kb;
	sub [yt500 ytk500]'  yb400		by	$kb;
	sub [yt500 ytk500]'  yb500		by	$kb;
	sub [yt500 ytk500]'	yb600		by	$kb;
	sub [yt500 ytk500]'	yb700		by	$kb;

	sub [yt600 ytk600]'	@YbLow		by	$kb;
	sub [yt600 ytk600]'	yb100		by	$kb;
	sub [yt600 ytk600]'	yb200		by	$kb;
	sub [yt600 ytk600]'	yb300		by	$kb;
	sub [yt600 ytk600]'	yb400		by	$kb;
	sub [yt600 ytk600]'	yb500		by	$kb;
	sub [yt600 ytk600]'	yb600		by	$kb;
	sub [yt600 ytk600]'	yb700		by	$kb;
	sub [yt600 ytk600]'	yb800		by	$kb;

	sub [yt700 ytk700]'	@YbLow		by	$kb;
	sub [yt700 ytk700]'	yb100		by	$kb;
	sub [yt700 ytk700]'	yb200		by	$kb;
	sub [yt700 ytk700]'	yb300		by	$kb;
	sub [yt700 ytk700]'	yb400		by	$kb;
	sub [yt700 ytk700]'	yb500		by	$kb;
	sub [yt700 ytk700]'	yb600		by	$kb;
	sub [yt700 ytk700]'	yb700		by	$kb;
	sub [yt700 ytk700]'	yb800		by	$kb;
	sub [yt700 ytk700]'	yb900		by	$kb;

	sub [yt800 ytk800]'	@YbLow		by	$kb;
	sub [yt800 ytk800]'	yb100		by	$kb;
