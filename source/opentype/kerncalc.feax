# Using two separate lookups may be more efficient in terms of searching through lists of lookup strings.
# The first lookup shifts a slice from the immediate next glyph for comparison.
lookup _ShiftFromNext {
	lookupflag UseMarkFilteringSet [ybLast @YbMarker];

	#sub ybLast' lookup _B4lastInsYb_1 lookup _B4lastInsYb_2 lookup _B4lastInsYb_3 @YbMarker';

	sub ybLast' lookup _B4lastInsYbLow	ybN1500';	# treat anything lower than -400 as -1000,
	sub ybLast' lookup _B4lastInsYbLow	ybN1400';	# ie, too low to kern underneath
	sub ybLast' lookup _B4lastInsYbLow	ybN1300';	#    \/
	sub ybLast' lookup _B4lastInsYbLow	ybN1200';	#    \/
	sub ybLast' lookup _B4lastInsYbLow	ybN1100';	#    \/
	sub ybLast' lookup _B4lastInsYbLow	ybN1000';	#    \/
	sub ybLast' lookup _B4lastInsYbLow	ybN1000';	#    \/
