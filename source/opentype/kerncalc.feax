	lookupflag UseMarkFilteringSet [ybLast @YbMarker];

	# shift from third glyph over:
	sub ybLast' lookup _B4lastInsYbLow	ybLast'	ybN1500';	# treat anything lower than -400 as -1000,
	sub ybLast' lookup _B4lastInsYbLow	ybLast'	ybN1400';	# ie, too low to kern underneath
